# Beta environment for NextBizStudio — copy to .env.beta (untracked) and fill.
# Deployed by: scripts/deploy.sh --env beta (systemd timer, every 5 min).
# NEVER commit .env.beta — it is gitignored; secrets stay out of the repo.

# Postgres (beta db container: nextbiz_beta_db)
DATABASE_URL=postgres://nextbiz:nextbiz@nextbiz-beta-db:5432/nextbiz

# Public site content — same as prod (baked at build time)
NEXT_PUBLIC_WHATSAPP_NUMBER=<same as prod>
NEXT_PUBLIC_WHATSAPP_PREFILL=<same as prod>
NEXT_PUBLIC_CDN_BASE=<same as prod>

# Slack — DISABLED on beta: lead-form tests must never hit the real channel
SLACK_WEBHOOK_URL=

# Admin configurator — same creds as prod (internal login)
ADMIN_USER=<same as prod>
ADMIN_PASS=<same as prod>

# Session signing — beta gets its OWN secret (no cookie/session reuse with prod)
SESSION_SECRET=<generate: openssl rand -hex 32>

IP_HASH_SALT=<generate: openssl rand -hex 16>

# R2/CDN — real creds so the upload flow stays testable on beta.
# NOTE: beta test uploads land in the PROD cdn bucket (removable junk paths).
CLOUDFLARE_ACCOUNT_ID=<same as prod>
CLOUDFLARE_R2_ACCESS_KEY_ID=<same as prod>
CLOUDFLARE_R2_SECRET_ACCESS_KEY=<same as prod>
R2_S3_ENDPOINT=<same as prod>
R2_CDN_BUCKET=<same as prod>
CDN_PUBLIC_DOMAIN=<same as prod>
